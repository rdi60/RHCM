# --- Database ---
DATABASE_URL="postgresql://rhcm:rhcm_dev_password@localhost:5432/rhcm?schema=public"

# --- Sessions ---
SESSION_SECRET="change-me-to-a-long-random-string"
REDIS_URL="redis://localhost:6379"
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Object storage (S3-compatible / MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="rhcm_minio"
S3_SECRET_ACCESS_KEY="rhcm_minio_password"
S3_BUCKET="rhcm-documents"
S3_FORCE_PATH_STYLE=true

# --- App ---
API_PORT=4000
WEB_PORT=3000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# --- MFA ---
MFA_ISSUER_NAME="RHCM"
# 32 raw bytes, base64-encoded. Generate your own per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The value below is a non-secret placeholder for local dev only.
MFA_ENCRYPTION_KEY="AgxNsNye3Zl22UFoP5at/h+kXqIlnnDFVPibhKwd0wI="

# --- Login lockout ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Rate limiting on auth endpoints (brute-force protection) ---
# Read directly from the OS environment at module-load time, before
# .env-file parsing runs — see apps/api/src/auth/auth.controller.ts.
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_MS=60000
AUTH_PASSWORD_THROTTLE_LIMIT=5

# --- Bootstrap (first Super Administrator; see docs/ARCHITECTURE.md section 4.3 - no hardcoded password ships) ---
BOOTSTRAP_ADMIN_EMAIL=""
