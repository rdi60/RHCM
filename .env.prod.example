# Copy to .env.prod, fill in every value, and never commit the filled-in file.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

POSTGRES_USER=rhcm
POSTGRES_PASSWORD=
POSTGRES_DB=rhcm

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
MFA_ISSUER_NAME=RHCM

# Public URLs your reverse proxy/TLS terminator routes to the web and api
# services respectively — see the Deployment section in README.md.
WEB_BASE_URL=https://app.yourclinic.example
NEXT_PUBLIC_API_BASE_URL=https://api.yourclinic.example

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Object storage — MinIO's own admin credentials in this self-contained
# compose file; point at your real S3/S3-compatible provider's keys instead
# if you swap the minio service out for one.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rhcm-documents
