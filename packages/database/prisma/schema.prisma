// RHCM — Stage 1 schema: tenancy, auth, RBAC, staff.
// See docs/ARCHITECTURE.md Section 5 for the full target design.
// Later stages extend this file additively (new models / new columns),
// never by reshaping what Stage 1 ships.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Entity {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "CLINIC", "TRUST"
  legalName   String
  displayName String
  timezone    String  @default("Asia/Kolkata")
  currency    String  @default("INR")
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings               EntitySettings?
  userAccess             UserEntityAccess[]
  roles                  Role[]
  resources              ClinicResource[]
  availability           DoctorAvailability[]
  doctorLeaves           DoctorLeave[]
  doctorAssignments      DoctorEntityAssignment[]
  staffAssignments       StaffEntityAssignment[]
  auditLogs              AuditLog[]
  temporaryRegistrations TemporaryRegistration[]
  patientEntityLinks     PatientEntityLink[]
  consentRecords         ConsentRecord[]
  appointments           Appointment[]
  visits                 Visit[]
  treatmentPlans         TreatmentPlan[]
  treatmentSessions      TreatmentSession[]
  prescriptions          Prescription[]

  @@map("entities")
}

model EntitySettings {
  id       String @id @default(cuid())
  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  brandingJson Json?

  invoicePrefix   String @default("INV")
  invoiceNextSeq  Int    @default(1)
  receiptPrefix   String @default("RCT")
  receiptNextSeq  Int    @default(1)
  estimatePrefix  String @default("EST")
  estimateNextSeq Int    @default(1)
  tempRegPrefix   String @default("TMP")
  tempRegNextSeq  Int    @default(1)
  visitPrefix     String @default("VS")
  visitNextSeq    Int    @default(1)

  gstin       String?
  addressJson Json?
  contactJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entity_settings")
}

enum ResourceType {
  CHAIR
  OT
}

model ClinicResource {
  id       String       @id @default(cuid())
  entityId String
  entity   Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type     ResourceType
  number   Int
  label    String?
  isActive Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  visits       Visit[]

  @@unique([entityId, type, number])
  @@index([entityId])
  @@map("clinic_resources")
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  phone              String?
  passwordHash       String
  mfaSecretEncrypted String?
  mfaEnabled         Boolean    @default(false)
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  pendingMfaSecretEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityAccess                  UserEntityAccess[]
  doctorProfile                 Doctor?
  staffProfile                  Staff?
  rolesCreated                  Role[]                  @relation("RoleCreatedBy")
  auditLogs                     AuditLog[]
  consentsCaptured              ConsentRecord[]
  temporaryRegistrationsCreated TemporaryRegistration[]
  appointmentsCreated           Appointment[]
  dentalChartEntriesRecorded    DentalChartEntry[]
  treatmentPlansCreated         TreatmentPlan[]
  clinicalNotesAuthored         ClinicalNote[]

  @@map("users")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "patient.read", "invoice.void"
  category    String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id       String  @id @default(cuid())
  // NULL entityId = a system role template usable at any entity.
  // Non-null = a custom role scoped to one entity.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name     String
  isSystem Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("RoleCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  userAccess  UserEntityAccess[]

  @@unique([entityId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserEntityAccess {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  grantedById String?
  grantedAt   DateTime @default(now())

  @@unique([userId, entityId, roleId])
  @@index([entityId])
  @@map("user_entity_access")
}

// ---------------------------------------------------------------------------
// Doctors & Staff
// ---------------------------------------------------------------------------

model Doctor {
  id                     String  @id @default(cuid())
  userId                 String? @unique
  user                   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName               String
  registrationNumber     String  @unique
  qualificationsJson     Json?
  specialtiesJson        Json?
  defaultConsultationFee Decimal @default(0) @db.Decimal(12, 2)
  isActive               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability                  DoctorAvailability[]
  leaves                        DoctorLeave[]
  assignments                   DoctorEntityAssignment[]
  preferredForTempRegistrations TemporaryRegistration[]
  appointments                  Appointment[]
  visits                        Visit[]
  diagnosesGiven                Diagnosis[]              @relation("DiagnosisDiagnosedBy")
  planItemsPlanned              TreatmentPlanItem[]      @relation("PlanItemPlannedDoctor")
  sessionsPlanned               TreatmentSession[]       @relation("SessionPlannedBy")
  sessionsAssigned              TreatmentSession[]       @relation("SessionAssignedTo")
  sessionsPerformed             TreatmentSession[]       @relation("SessionPerformedBy")
  prescriptions                 Prescription[]

  @@map("doctors")
}

model DoctorEntityAssignment {
  id         String   @id @default(cuid())
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([doctorId, entityId])
  @@index([entityId])
  @@map("doctor_entity_assignments")
}

model Staff {
  id           String  @id @default(cuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  designation  String
  employeeCode String  @unique
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments                 StaffEntityAssignment[]
  treatmentSessionAssistances TreatmentSessionAssistant[]

  @@map("staff")
}

model StaffEntityAssignment {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([staffId, entityId])
  @@index([entityId])
  @@map("staff_entity_assignments")
}

model DoctorAvailability {
  id                  String    @id @default(cuid())
  doctorId            String
  doctor              Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entityId            String
  entity              Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  weekday             Int // 0=Sunday .. 6=Saturday
  startTime           String // "09:00" (stored as HH:mm; date-agnostic recurring slot)
  endTime             String // "17:00"
  slotDurationMinutes Int       @default(15)
  breakStart          String?
  breakEnd            String?
  isRecurring         Boolean   @default(true)
  effectiveFrom       DateTime  @db.Date
  effectiveTo         DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, entityId])
  @@map("doctor_availability")
}

model DoctorLeave {
  id       String   @id @default(cuid())
  doctorId String
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  dateFrom DateTime @db.Date
  dateTo   DateTime @db.Date
  reason   String?

  createdAt DateTime @default(now())

  @@index([doctorId, entityId])
  @@map("doctor_leave")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityId     String?
  entity       Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  beforeJson   Json?
  afterJson    Json?

  @@index([entityId])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Patients (Stage 2)
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  MERGED
}

enum TempRegistrationStatus {
  OPEN
  CHECKED_IN
  EXPIRED
  DISCARDED
}

enum ConsentType {
  TREATMENT
  DATA_SHARING
  CROSS_ENTITY_IDENTITY_LINKING
  PHOTO_VIDEO
  MARKETING
}

/// Single-row counter for the global, never-reused UHID sequence. Patients
/// are not entity-owned (see docs/ARCHITECTURE.md Section 3.1), so this is
/// deliberately separate from the per-entity counters on EntitySettings.
model UhidCounter {
  id      Int    @id @default(1)
  prefix  String @default("RD")
  nextSeq Int    @default(1)

  @@map("uhid_counter")
}

model Patient {
  id   String @id @default(cuid())
  uhid String @unique

  fullName String
  dob      DateTime? @db.Date
  ageYears Int? // captured when exact DOB is unknown
  gender   Gender    @default(UNSPECIFIED)

  phone String?
  email String?

  addressJson          Json?
  emergencyContactJson Json?
  guardianJson         Json? // required in practice for minors; enforced in the service layer, not the schema

  medicalAlertsJson  Json?
  allergiesJson      Json?
  medicalHistoryJson Json?

  status              PatientStatus @default(ACTIVE)
  mergedIntoPatientId String?
  mergedIntoPatient   Patient?      @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id])
  mergedFromPatients  Patient[]     @relation("PatientMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityLinks            PatientEntityLink[]
  consentRecords         ConsentRecord[]
  temporaryRegistrations TemporaryRegistration[]
  appointments           Appointment[]
  visits                 Visit[]
  diagnoses              Diagnosis[]
  dentalChartEntries     DentalChartEntry[]
  treatmentPlans         TreatmentPlan[]
  clinicalNotes          ClinicalNote[]
  prescriptions          Prescription[]

  @@index([fullName])
  @@index([phone])
  @@map("patients")
}

model PatientEntityLink {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  firstVisitAt DateTime @default(now())

  @@unique([patientId, entityId])
  @@index([entityId])
  @@map("patient_entity_links")
}

model TemporaryRegistration {
  id     String @id @default(cuid())
  // e.g. "TMP-000123" — its own per-entity sequence, a visually distinct
  // format from UHID so the two are never confused. Scoped to (entityId,
  // tempId) rather than globally unique: the counter lives on each
  // entity's EntitySettings row, so two entities both starting from
  // TMP-000001 is expected, not a collision.
  tempId String

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String?
  dob         DateTime? @db.Date
  ageYears    Int?
  gender      Gender    @default(UNSPECIFIED)
  visitReason String?

  preferredDoctorId String?
  preferredDoctor   Doctor? @relation(fields: [preferredDoctorId], references: [id], onDelete: SetNull)

  status TempRegistrationStatus @default(OPEN)

  matchedPatientId String?
  matchedPatient   Patient? @relation(fields: [matchedPatientId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([entityId, tempId])
  @@index([phone])
  @@map("temporary_registrations")
}

model ConsentRecord {
  id          String      @id @default(cuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entityId    String
  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  consentType ConsentType
  granted     Boolean
  grantedAt   DateTime    @default(now())

  capturedById String?
  capturedBy   User?   @relation(fields: [capturedById], references: [id], onDelete: SetNull)

  documentRef String?
  version     Int     @default(1)

  @@index([patientId])
  @@index([entityId])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Scheduling (Stage 3)
// ---------------------------------------------------------------------------

enum AppointmentType {
  CONSULTATION
  TREATMENT
  FOLLOW_UP
  EMERGENCY
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  CHECKED_IN
  WAITING
  IN_TREATMENT
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

/// Double-booking (same doctor, or same chair/OT, overlapping time) is
/// prevented at the DATABASE level by partial GIST exclusion constraints
/// hand-written into this model's migration (Prisma has no schema syntax
/// for EXCLUDE constraints) — see
/// packages/database/prisma/migrations/*_stage3_appointments/migration.sql.
/// Those constraints are the actual guarantee; application code re-checks
/// before insert only to fail fast with a friendly message.
///
/// Authorized emergency override: an EMERGENCY-type appointment created by
/// a caller holding appointment.override_conflict may set
/// isEmergencyOverride=true, which is excluded from the doctor-conflict
/// constraint's predicate (never the resource/chair constraint — two
/// patients still can't physically occupy one chair). This is a documented,
/// narrow trade-off: once an override exists, the doctor-conflict
/// constraint no longer compares new bookings against that specific slot
/// either, so the UI's live availability check (not just the DB
/// constraint) is what actually warns reception of the resulting overlap
/// before they book over it.
model Appointment {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Exactly one of these two is set — enforced by a CHECK constraint in the
  // migration, same reason as the exclusion constraints above.
  patientId               String?
  patient                 Patient?               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  temporaryRegistrationId String?
  temporaryRegistration   TemporaryRegistration? @relation(fields: [temporaryRegistrationId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  resourceId String?
  resource   ClinicResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  type          AppointmentType   @default(CONSULTATION)
  status        AppointmentStatus @default(BOOKED)
  procedureHint String?
  remarks       String?

  isEmergencyOverride Boolean @default(false)

  rescheduledFromId String?       @unique
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]

  @@index([entityId, startAt])
  @@index([doctorId, startAt])
  @@index([resourceId, startAt])
  @@map("appointments")
}

enum VisitStatus {
  WAITING
  IN_TREATMENT
  COMPLETED
  CANCELLED
}

model Visit {
  id          String @id @default(cuid())
  visitNumber String // e.g. "VS-000123", per-entity sequence (EntitySettings.visitNextSeq)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Nullable: a walk-in checked in without a preferred doctor on file isn't
  // blocked — triage/reception assigns one afterwards (PATCH .../assign).
  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  resourceId String?
  resource   ClinicResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  chiefComplaint String?
  status         VisitStatus @default(WAITING)

  // Stage 4: the clinical summary of this encounter. Detailed diagnoses,
  // dental-chart entries, treatment plans/sessions, notes and
  // prescriptions live in their own append-only-friendly tables below;
  // these four fields are the short free-text summary shown on the
  // visit/dashboard, filled in as the encounter wraps up.
  clinicalFindings             String?
  diagnosisSummary             String?
  treatmentAdvice              String?
  nextAppointmentRecommendedAt DateTime?

  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnoses          Diagnosis[]
  dentalChartEntries DentalChartEntry[]
  treatmentPlans     TreatmentPlan[]
  treatmentSessions  TreatmentSession[]
  clinicalNotes      ClinicalNote[]
  prescriptions      Prescription[]

  @@unique([entityId, visitNumber])
  @@index([entityId, status])
  @@map("visits")
}

// ---------------------------------------------------------------------------
// Clinical module (Stage 4)
// ---------------------------------------------------------------------------

/// Global procedure master (not entity-scoped) — see
/// docs/ARCHITECTURE.md Section 5.9 for why per-entity *pricing* is a
/// separate override table added in a later stage rather than forking
/// this catalog.
model TreatmentCatalog {
  id                     String  @id @default(cuid())
  code                   String  @unique
  name                   String
  category               String
  defaultDurationMinutes Int     @default(30)
  defaultPrice           Decimal @default(0) @db.Decimal(12, 2)
  isActive               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planItems TreatmentPlanItem[]

  @@map("treatment_catalog")
}

enum Dentition {
  PERMANENT
  DECIDUOUS
}

/// Append-only: a correction is a new row, never an UPDATE, so the full
/// history for a tooth/surface is reconstructable. The odontogram the UI
/// renders is just "the latest row per (patient, toothNumber, surface)".
model DentalChartEntry {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  toothNumber Int // FDI notation
  dentition   Dentition @default(PERMANENT)
  surface     String? // e.g. "M", "O", "D", "B", "L"; null = whole-tooth condition
  condition   String // free text (e.g. "Caries", "Filled", "Crown", "Missing", "Healthy") — deliberately not an enum, dental conditions vary too much to fix a closed list
  status      String? // e.g. "active", "resolved", "planned"

  recordedAt   DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  visitId      String?
  visit        Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([patientId, toothNumber])
  @@map("dental_chart_entries")
}

model Diagnosis {
  id String @id @default(cuid())

  visitId   String
  visit     Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  toothNumber   Int?
  diagnosisCode String?
  description   String

  diagnosedById String?
  diagnosedBy   Doctor?  @relation("DiagnosisDiagnosedBy", fields: [diagnosedById], references: [id], onDelete: SetNull)
  diagnosedAt   DateTime @default(now())

  @@index([patientId])
  @@index([visitId])
  @@map("diagnoses")
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model TreatmentPlan {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  visitId   String?
  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  status TreatmentPlanStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TreatmentPlanItem[]

  @@index([patientId])
  @@index([entityId])
  @@map("treatment_plans")
}

enum TreatmentPlanItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TreatmentPlanItem {
  id String @id @default(cuid())

  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  toothNumber        Int?
  treatmentCatalogId String
  treatmentCatalog   TreatmentCatalog @relation(fields: [treatmentCatalogId], references: [id], onDelete: Restrict)

  plannedDoctorId String?
  plannedDoctor   Doctor? @relation("PlanItemPlannedDoctor", fields: [plannedDoctorId], references: [id], onDelete: SetNull)

  quantity      Int                     @default(1)
  estimatedCost Decimal                 @default(0) @db.Decimal(12, 2)
  status        TreatmentPlanItemStatus @default(PLANNED)
  sortOrder     Int                     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions TreatmentSession[]

  @@index([treatmentPlanId])
  @@map("treatment_plan_items")
}

enum TreatmentSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// The "Treatment ID" from the spec. A single TreatmentPlanItem (e.g. "Root
/// Canal, tooth 36") fans out into N of these over time, supporting
/// multi-session procedures.
model TreatmentSession {
  id String @id @default(cuid())

  treatmentPlanItemId String
  treatmentPlanItem   TreatmentPlanItem @relation(fields: [treatmentPlanItemId], references: [id], onDelete: Cascade)
  visitId             String?
  visit               Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  entityId            String
  entity              Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)

  toothNumber   Int?
  procedureCode String?

  plannedByDoctorId   String?
  plannedByDoctor     Doctor? @relation("SessionPlannedBy", fields: [plannedByDoctorId], references: [id], onDelete: SetNull)
  assignedDoctorId    String?
  assignedDoctor      Doctor? @relation("SessionAssignedTo", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  performedByDoctorId String?
  performedByDoctor   Doctor? @relation("SessionPerformedBy", fields: [performedByDoctorId], references: [id], onDelete: SetNull)

  plannedDate DateTime?              @db.Date
  actualDate  DateTime?              @db.Date
  status      TreatmentSessionStatus @default(PLANNED)

  estimatedCost      Decimal  @default(0) @db.Decimal(12, 2)
  actualBilledAmount Decimal? @db.Decimal(12, 2)
  clinicalRemarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assistants TreatmentSessionAssistant[]

  @@index([treatmentPlanItemId])
  @@index([entityId])
  @@map("treatment_sessions")
}

model TreatmentSessionAssistant {
  treatmentSessionId String
  treatmentSession   TreatmentSession @relation(fields: [treatmentSessionId], references: [id], onDelete: Cascade)
  staffId            String
  staff              Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([treatmentSessionId, staffId])
  @@map("treatment_session_assistants")
}

/// Append-only for medico-legal integrity: a correction is a new row
/// linked via supersedesNoteId (an addendum), never an UPDATE to body.
model ClinicalNote {
  id String @id @default(cuid())

  visitId   String
  visit     Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  authoredById String?
  authoredBy   User?    @relation(fields: [authoredById], references: [id], onDelete: SetNull)
  authoredAt   DateTime @default(now())

  noteType String @default("general")
  body     String

  isAddendum       Boolean        @default(false)
  supersedesNoteId String?
  supersedesNote   ClinicalNote?  @relation("NoteAddendum", fields: [supersedesNoteId], references: [id])
  addenda          ClinicalNote[] @relation("NoteAddendum")

  @@index([patientId])
  @@index([visitId])
  @@map("clinical_notes")
}

model Prescription {
  id String @id @default(cuid())

  visitId   String
  visit     Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  prescribedById String?
  prescribedBy   Doctor?  @relation(fields: [prescribedById], references: [id], onDelete: SetNull)
  prescribedAt   DateTime @default(now())

  // [{ drugName, dosage, frequency, durationDays, instructions }]
  itemsJson Json
  notes     String?

  @@index([patientId])
  @@map("prescriptions")
}
